client
dev tun
proto {{.Proto}}
remote {{.Host}} {{.Port}}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name {{.ServerName}} name
cipher AES-256-GCM
auth SHA256
tls-version-min 1.3
verb 3
auth-nocache
auth-user-pass
reneg-sec 0
key-direction 1
<ca>
{{.CACert}}
</ca>
<cert>
{{.UserCert}}
</cert>
<key>
{{.UserKey}}
</key>
<tls-auth>
{{.TAKey}}
</tls-auth>
